# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
# Runtime assembly only: compiled frontend supplied by CI or local build.
FROM node:24-bookworm-slim@sha256:3638d9a6fe4030bd716be989438248074489337ba3275657f93595428be4fc03
ARG VERSION=dev
ARG REVISION=unknown
ARG SOURCE_URL=https://github.com/ravenroot-ai/ravenroot
ARG CREATED=""
LABEL org.opencontainers.image.title="Ravenroot UI" \
      org.opencontainers.image.description="Independent static frontend and streaming API proxy" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.source="${SOURCE_URL}" \
      org.opencontainers.image.documentation="https://docs.ravenroot.ai" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.created="${CREATED}"
WORKDIR /opt/ravenroot
COPY ci-artifacts/ui/ ./ui/
COPY ui-server/server.mjs ./server.mjs
USER 10001:10001
ENV RAVENROOT_UI_PORT=8080
EXPOSE 8080
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
  CMD ["node", "--input-type=module", "-e", "fetch('http://127.0.0.1:'+ (process.env.RAVENROOT_UI_PORT || 8080) +'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
ENTRYPOINT ["node", "/opt/ravenroot/server.mjs"]
