{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["replicaCount", "runnerPlane", "image", "service", "auth", "engine", "executionRuntime", "graph", "ai", "humanTask", "assistant", "programAuthoring", "rateLimit", "programTimeoutMs", "resources", "podSecurityContext", "securityContext", "probes", "tmpfs", "persistence"],
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1, "maximum": 1 },
    "programTimeoutMs": {
      "x-ravenroot-environment": "RAVENROOT_PROGRAM_TIMEOUT_MS",
      "oneOf": [{ "type": "integer", "minimum": 100, "maximum": 300000 }, { "$ref": "#/definitions/graphBlank" }]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "audience", "jwksUri"],
      "properties": {
        "issuer": { "type": "string", "minLength": 1, "not": { "$ref": "#/definitions/graphBlank" } },
        "audience": { "type": "string", "minLength": 1, "not": { "$ref": "#/definitions/graphBlank" } },
        "jwksUri": { "type": "string", "minLength": 1, "not": { "$ref": "#/definitions/graphBlank" } }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port"],
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "engine": { "type": "string", "enum": ["pekko"] },
    "executionRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxStashedCommandsPerNode", "lifecycleStepSeconds",
        "terminalHistoryCapacity", "runnerShutdownStepSeconds"
      ],
      "properties": {
        "maxStashedCommandsPerNode": {
          "x-ravenroot-environment": "RAVENROOT_ENGINE_MAX_STASHED_COMMANDS_PER_NODE",
          "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 10000 }, { "$ref": "#/definitions/graphBlank" }]
        },
        "lifecycleStepSeconds": {
          "x-ravenroot-environment": "RAVENROOT_ENGINE_LIFECYCLE_STEP_SECONDS",
          "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 10 }, { "$ref": "#/definitions/graphBlank" }]
        },
        "terminalHistoryCapacity": {
          "x-ravenroot-environment": "RAVENROOT_ENGINE_TERMINAL_HISTORY_CAPACITY",
          "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 1024 }, { "$ref": "#/definitions/graphBlank" }]
        },
        "runnerShutdownStepSeconds": {
          "x-ravenroot-environment": "RAVENROOT_GRAPH_RUNNER_SHUTDOWN_STEP_SECONDS",
          "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 10 }, { "$ref": "#/definitions/graphBlank" }]
        }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["graphMl", "payload", "execution"],
      "properties": {
        "graphMl": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxBytes", "maxNodes", "maxEdges", "maxProperties", "maxDepth",
            "maxStringLength", "maxKeys", "maxElements", "maxAttributes",
            "maxNamespaceDeclarations"
          ],
          "properties": {
            "maxBytes": {
              "x-ravenroot-environment": "RAVENROOT_GRAPHML_MAX_BYTES",
              "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 268435456 }, { "$ref": "#/definitions/graphBlank" }]
            },
            "maxNodes": {
              "x-ravenroot-environment": "RAVENROOT_GRAPH_MAX_NODES",
              "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 1000000 }, { "$ref": "#/definitions/graphBlank" }]
            },
            "maxEdges": {
              "x-ravenroot-environment": "RAVENROOT_GRAPH_MAX_EDGES",
              "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 5000000 }, { "$ref": "#/definitions/graphBlank" }]
            },
            "maxProperties": {
              "x-ravenroot-environment": "RAVENROOT_GRAPH_MAX_PROPERTIES",
              "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 10000000 }, { "$ref": "#/definitions/graphBlank" }]
            },
            "maxDepth": {
              "x-ravenroot-environment": "RAVENROOT_GRAPHML_MAX_DEPTH",
              "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 1024 }, { "$ref": "#/definitions/graphBlank" }]
            },
            "maxStringLength": {
              "x-ravenroot-environment": "RAVENROOT_GRAPHML_MAX_STRING_LENGTH",
              "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 67108864 }, { "$ref": "#/definitions/graphBlank" }]
            },
            "maxKeys": {
              "x-ravenroot-environment": "RAVENROOT_GRAPHML_MAX_KEYS",
              "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 100000 }, { "$ref": "#/definitions/graphBlank" }]
            },
            "maxElements": {
              "x-ravenroot-environment": "RAVENROOT_GRAPHML_MAX_ELEMENTS",
              "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 10000000 }, { "$ref": "#/definitions/graphBlank" }]
            },
            "maxAttributes": {
              "x-ravenroot-environment": "RAVENROOT_GRAPHML_MAX_ATTRIBUTES",
              "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 20000000 }, { "$ref": "#/definitions/graphBlank" }]
            },
            "maxNamespaceDeclarations": {
              "x-ravenroot-environment": "RAVENROOT_GRAPHML_MAX_NAMESPACE_DECLARATIONS",
              "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 1000000 }, { "$ref": "#/definitions/graphBlank" }]
            }
          }
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxEncodedBytes", "maxDepth", "maxCollectionSize", "maxValueCount",
            "maxTextLength", "maxKeyLength"
          ],
          "properties": {
            "maxEncodedBytes": {
              "x-ravenroot-environment": "RAVENROOT_GRAPH_MAX_PAYLOAD_BYTES",
              "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 67108864 }, { "$ref": "#/definitions/graphBlank" }]
            },
            "maxDepth": {
              "x-ravenroot-environment": "RAVENROOT_GRAPH_MAX_PAYLOAD_DEPTH",
              "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 256 }, { "$ref": "#/definitions/graphBlank" }]
            },
            "maxCollectionSize": {
              "x-ravenroot-environment": "RAVENROOT_GRAPH_MAX_PAYLOAD_COLLECTION_SIZE",
              "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 1000000 }, { "$ref": "#/definitions/graphBlank" }]
            },
            "maxValueCount": {
              "x-ravenroot-environment": "RAVENROOT_GRAPH_MAX_PAYLOAD_VALUE_COUNT",
              "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 5000000 }, { "$ref": "#/definitions/graphBlank" }]
            },
            "maxTextLength": {
              "x-ravenroot-environment": "RAVENROOT_GRAPH_MAX_PAYLOAD_TEXT_LENGTH",
              "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 67108864 }, { "$ref": "#/definitions/graphBlank" }]
            },
            "maxKeyLength": {
              "x-ravenroot-environment": "RAVENROOT_GRAPH_MAX_PAYLOAD_KEY_LENGTH",
              "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 4096 }, { "$ref": "#/definitions/graphBlank" }]
            }
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxFanOut", "maxResidentActors", "maxLiveActorsPerTraversal",
            "maxInFlightHopsPerTraversal", "maxQueuedAdmissionsPerNode", "maxTraversalSteps",
            "maxAmplifiedDeliveries", "maxCumulativePayloadBytes",
            "maxRecoveryDeliveriesPerAttempt"
          ],
          "properties": {
            "maxFanOut": {
              "x-ravenroot-environment": "RAVENROOT_GRAPH_MAX_FAN_OUT",
              "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 256 }, { "$ref": "#/definitions/graphBlank" }]
            },
            "maxResidentActors": {
              "x-ravenroot-environment": "RAVENROOT_GRAPH_MAX_RESIDENT_ACTORS",
              "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 4096 }, { "$ref": "#/definitions/graphBlank" }]
            },
            "maxLiveActorsPerTraversal": {
              "x-ravenroot-environment": "RAVENROOT_GRAPH_MAX_LIVE_ACTORS_PER_TRAVERSAL",
              "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 1024 }, { "$ref": "#/definitions/graphBlank" }]
            },
            "maxInFlightHopsPerTraversal": {
              "x-ravenroot-environment": "RAVENROOT_GRAPH_MAX_IN_FLIGHT_HOPS",
              "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 4096 }, { "$ref": "#/definitions/graphBlank" }]
            },
            "maxQueuedAdmissionsPerNode": {
              "x-ravenroot-environment": "RAVENROOT_GRAPH_MAX_QUEUED_ADMISSIONS_PER_NODE",
              "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 4096 }, { "$ref": "#/definitions/graphBlank" }]
            },
            "maxTraversalSteps": {
              "x-ravenroot-environment": "RAVENROOT_GRAPH_MAX_TRAVERSAL_STEPS",
              "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 1000000 }, { "$ref": "#/definitions/graphBlank" }]
            },
            "maxAmplifiedDeliveries": {
              "x-ravenroot-environment": "RAVENROOT_GRAPH_MAX_AMPLIFIED_DELIVERIES",
              "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 1000000 }, { "$ref": "#/definitions/graphBlank" }]
            },
            "maxCumulativePayloadBytes": {
              "x-ravenroot-environment": "RAVENROOT_GRAPH_MAX_CUMULATIVE_PAYLOAD_BYTES",
              "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 268435456 }, { "$ref": "#/definitions/graphBlank" }]
            },
            "maxRecoveryDeliveriesPerAttempt": {
              "x-ravenroot-environment": "RAVENROOT_GRAPH_MAX_RECOVERY_DELIVERIES_PER_ATTEMPT",
              "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 64 }, { "$ref": "#/definitions/graphBlank" }]
            }
          }
        }
      }
    },
    "ai": { "$ref": "#/definitions/aiConfiguration" },
    "assistant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxOutputTokens", "maxToolIterations"],
      "properties": {
        "maxOutputTokens": {
          "x-ravenroot-environment": "RAVENROOT_ASSISTANT_MAX_OUTPUT_TOKENS",
          "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 16000 }, { "$ref": "#/definitions/graphBlank" }]
        },
        "maxToolIterations": {
          "x-ravenroot-environment": "RAVENROOT_ASSISTANT_MAX_TOOL_ITERATIONS",
          "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 8 }, { "$ref": "#/definitions/graphBlank" }]
        }
      }
    },
    "programAuthoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxSourceBytes", "maxBuildRequestBytes", "maxProgramsPerBuild"],
      "properties": {
        "maxSourceBytes": {
          "x-ravenroot-environment": "RAVENROOT_PROGRAM_AUTHORING_MAX_SOURCE_BYTES",
          "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 1048576 }, { "$ref": "#/definitions/graphBlank" }]
        },
        "maxBuildRequestBytes": {
          "x-ravenroot-environment": "RAVENROOT_PROGRAM_AUTHORING_MAX_BUILD_REQUEST_BYTES",
          "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 10485760 }, { "$ref": "#/definitions/graphBlank" }]
        },
        "maxProgramsPerBuild": {
          "x-ravenroot-environment": "RAVENROOT_PROGRAM_AUTHORING_MAX_PROGRAMS_PER_BUILD",
          "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 256 }, { "$ref": "#/definitions/graphBlank" }]
        }
      }
    },
    "rateLimit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "addressRequestsPerSecond", "addressBurst", "tenantRequestsPerSecond", "tenantBurst",
        "principalRequestsPerSecond", "principalBurst", "submissionsPerSecond", "submissionBurst",
        "tenantConcurrentSubmissions", "globalActiveExecutions", "tenantConcurrentStreams",
        "principalConcurrentStreams", "streamQueueCapacity", "maxQueryBytes", "maxQueryParameters",
        "maxHeaderCount", "maxHeaderBytes", "maxHeaderValueBytes", "maxTrackedClients",
        "maxTrackedTenants", "maxTrackedPrincipals", "idleEntryTtlSeconds", "executionMaxAgeSeconds"
      ],
      "properties": {
        "addressRequestsPerSecond": {
          "x-ravenroot-environment": "RAVENROOT_RATELIMIT_ADDRESS_RPS",
          "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 1000000 }, { "$ref": "#/definitions/graphBlank" }]
        },
        "addressBurst": {
          "x-ravenroot-environment": "RAVENROOT_RATELIMIT_ADDRESS_BURST",
          "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 1000000 }, { "$ref": "#/definitions/graphBlank" }]
        },
        "tenantRequestsPerSecond": {
          "x-ravenroot-environment": "RAVENROOT_RATELIMIT_TENANT_RPS",
          "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 1000000 }, { "$ref": "#/definitions/graphBlank" }]
        },
        "tenantBurst": {
          "x-ravenroot-environment": "RAVENROOT_RATELIMIT_TENANT_BURST",
          "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 1000000 }, { "$ref": "#/definitions/graphBlank" }]
        },
        "principalRequestsPerSecond": {
          "x-ravenroot-environment": "RAVENROOT_RATELIMIT_PRINCIPAL_RPS",
          "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 1000000 }, { "$ref": "#/definitions/graphBlank" }]
        },
        "principalBurst": {
          "x-ravenroot-environment": "RAVENROOT_RATELIMIT_PRINCIPAL_BURST",
          "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 1000000 }, { "$ref": "#/definitions/graphBlank" }]
        },
        "submissionsPerSecond": {
          "x-ravenroot-environment": "RAVENROOT_RATELIMIT_SUBMISSION_RPS",
          "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 1000000 }, { "$ref": "#/definitions/graphBlank" }]
        },
        "submissionBurst": {
          "x-ravenroot-environment": "RAVENROOT_RATELIMIT_SUBMISSION_BURST",
          "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 1000000 }, { "$ref": "#/definitions/graphBlank" }]
        },
        "tenantConcurrentSubmissions": {
          "x-ravenroot-environment": "RAVENROOT_RATELIMIT_TENANT_CONCURRENT_SUBMISSIONS",
          "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 2147483647 }, { "$ref": "#/definitions/graphBlank" }]
        },
        "globalActiveExecutions": {
          "x-ravenroot-environment": "RAVENROOT_RATELIMIT_GLOBAL_ACTIVE_EXECUTIONS",
          "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 2147483647 }, { "$ref": "#/definitions/graphBlank" }]
        },
        "tenantConcurrentStreams": {
          "x-ravenroot-environment": "RAVENROOT_RATELIMIT_TENANT_STREAMS",
          "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 2147483647 }, { "$ref": "#/definitions/graphBlank" }]
        },
        "principalConcurrentStreams": {
          "x-ravenroot-environment": "RAVENROOT_RATELIMIT_PRINCIPAL_STREAMS",
          "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 2147483647 }, { "$ref": "#/definitions/graphBlank" }]
        },
        "streamQueueCapacity": {
          "x-ravenroot-environment": "RAVENROOT_SSE_QUEUE_CAPACITY",
          "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 2147483647 }, { "$ref": "#/definitions/graphBlank" }]
        },
        "maxQueryBytes": {
          "x-ravenroot-environment": "RAVENROOT_RATELIMIT_MAX_QUERY_BYTES",
          "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 2147483647 }, { "$ref": "#/definitions/graphBlank" }]
        },
        "maxQueryParameters": {
          "x-ravenroot-environment": "RAVENROOT_RATELIMIT_MAX_QUERY_PARAMETERS",
          "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 2147483647 }, { "$ref": "#/definitions/graphBlank" }]
        },
        "maxHeaderCount": {
          "x-ravenroot-environment": "RAVENROOT_RATELIMIT_MAX_HEADER_COUNT",
          "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 2147483647 }, { "$ref": "#/definitions/graphBlank" }]
        },
        "maxHeaderBytes": {
          "x-ravenroot-environment": "RAVENROOT_RATELIMIT_MAX_HEADER_BYTES",
          "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 2147483647 }, { "$ref": "#/definitions/graphBlank" }]
        },
        "maxHeaderValueBytes": {
          "x-ravenroot-environment": "RAVENROOT_RATELIMIT_MAX_HEADER_VALUE_BYTES",
          "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 2147483647 }, { "$ref": "#/definitions/graphBlank" }]
        },
        "maxTrackedClients": {
          "x-ravenroot-environment": "RAVENROOT_RATELIMIT_MAX_TRACKED_CLIENTS",
          "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 2147483647 }, { "$ref": "#/definitions/graphBlank" }]
        },
        "maxTrackedTenants": {
          "x-ravenroot-environment": "RAVENROOT_RATELIMIT_MAX_TRACKED_TENANTS",
          "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 2147483647 }, { "$ref": "#/definitions/graphBlank" }]
        },
        "maxTrackedPrincipals": {
          "x-ravenroot-environment": "RAVENROOT_RATELIMIT_MAX_TRACKED_PRINCIPALS",
          "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 2147483647 }, { "$ref": "#/definitions/graphBlank" }]
        },
        "idleEntryTtlSeconds": {
          "x-ravenroot-environment": "RAVENROOT_RATELIMIT_IDLE_TTL_SECONDS",
          "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 3600 }, { "$ref": "#/definitions/graphBlank" }]
        },
        "executionMaxAgeSeconds": {
          "x-ravenroot-environment": "RAVENROOT_RATELIMIT_EXECUTION_MAX_AGE_SECONDS",
          "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 86400 }, { "$ref": "#/definitions/graphBlank" }]
        }
      }
    },
    "humanTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "responderEnforcementEnabled", "interactionConfigSecret",
        "defaultResponseBytes", "maxResponseBytes", "defaultEscalationSeconds",
        "maxEscalationSeconds", "defaultExpirySeconds", "maxExpirySeconds", "maxTitleBytes",
        "maxDescriptionBytes", "maxResponseSchemaBytes", "maxAuthorizationTokens",
        "maxAuthorizationTokenBytes", "maxDecisionBodyBytes", "defaultPageSize", "maxPageSize",
        "responseMaxDepth", "responseMaxCollectionSize", "responseMaxValueCount",
        "responseMaxTextLength", "responseMaxKeyLength", "writeAttempts",
        "maxConfirmationPromptBytes", "maxConfirmationActionLabelBytes",
        "defaultReviewTextBytes", "maxReviewTextBytes",
        "maxDecisionCommentBytes", "attentionPollMillis",
        "attentionPollBackoffMaxMillis", "defaultAttentionPageSize",
        "maxAttentionPageSize"
      ],
      "properties": {
        "responderEnforcementEnabled": { "type": "boolean", "default": false },
        "interactionConfigSecret": { "type": "string", "maxLength": 253 },
        "defaultResponseBytes": { "$ref": "#/definitions/positiveInt64MiB" },
        "maxResponseBytes": { "$ref": "#/definitions/positiveInt64MiB" },
        "defaultEscalationSeconds": { "$ref": "#/definitions/nonNegativeEscalationSeconds" },
        "maxEscalationSeconds": { "$ref": "#/definitions/nonNegativeEscalationSeconds" },
        "defaultExpirySeconds": { "$ref": "#/definitions/positiveInt32" },
        "maxExpirySeconds": { "$ref": "#/definitions/positiveInt32" },
        "maxTitleBytes": { "$ref": "#/definitions/positiveInt64MiB" },
        "maxDescriptionBytes": { "$ref": "#/definitions/positiveInt64MiB" },
        "maxResponseSchemaBytes": { "$ref": "#/definitions/positive128" },
        "maxAuthorizationTokens": { "$ref": "#/definitions/positive256" },
        "maxAuthorizationTokenBytes": { "$ref": "#/definitions/positive4096" },
        "maxDecisionBodyBytes": { "$ref": "#/definitions/positiveInt64MiB" },
        "defaultPageSize": { "$ref": "#/definitions/positive1000" },
        "maxPageSize": { "$ref": "#/definitions/positive1000" },
        "responseMaxDepth": { "$ref": "#/definitions/positive256" },
        "responseMaxCollectionSize": { "$ref": "#/definitions/positiveMillion" },
        "responseMaxValueCount": { "$ref": "#/definitions/positiveFiveMillion" },
        "responseMaxTextLength": { "$ref": "#/definitions/positiveInt64MiB" },
        "responseMaxKeyLength": { "$ref": "#/definitions/positive4096" },
        "writeAttempts": { "$ref": "#/definitions/positive32" },
        "maxConfirmationPromptBytes": { "$ref": "#/definitions/positive65536" },
        "maxConfirmationActionLabelBytes": { "$ref": "#/definitions/positive256" },
        "defaultReviewTextBytes": { "$ref": "#/definitions/positive1048576" },
        "maxReviewTextBytes": { "$ref": "#/definitions/positive1048576" },
        "maxDecisionCommentBytes": { "$ref": "#/definitions/positive16384" },
        "attentionPollMillis": { "$ref": "#/definitions/pollMillis" },
        "attentionPollBackoffMaxMillis": { "$ref": "#/definitions/pollMillis" },
        "defaultAttentionPageSize": { "$ref": "#/definitions/positive100" },
        "maxAttentionPageSize": { "$ref": "#/definitions/positive100" }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accessModes", "size", "storageClass"],
      "properties": {
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["ReadWriteOnce"] }
        },
        "size": { "$ref": "#/definitions/kubernetesPositiveQuantity" },
        "storageClass": { "type": "string" }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "$ref": "#/definitions/resourceRequirements" },
        "limits": { "$ref": "#/definitions/resourceRequirements" }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runAsNonRoot", "fsGroup", "fsGroupChangePolicy", "seccompProfile"],
      "properties": {
        "runAsNonRoot": { "type": "boolean", "const": true },
        "fsGroup": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "fsGroupChangePolicy": { "type": "string", "enum": ["Always", "OnRootMismatch"] },
        "seccompProfile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "type": "string", "enum": ["RuntimeDefault"] }
          }
        }
      }
    },
    "securityContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowPrivilegeEscalation", "readOnlyRootFilesystem", "capabilities", "runAsUser", "runAsGroup"],
      "properties": {
        "allowPrivilegeEscalation": { "type": "boolean", "const": false },
        "readOnlyRootFilesystem": { "type": "boolean", "const": true },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["drop"],
          "properties": {
            "drop": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "enum": ["ALL"] }
            }
          }
        },
        "runAsUser": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "runAsGroup": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readiness", "liveness"],
      "properties": {
        "readiness": { "$ref": "#/definitions/httpProbeTiming" },
        "liveness": { "$ref": "#/definitions/httpProbeTiming" }
      }
    },
    "tmpfs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sizeLimit"],
      "properties": {
        "sizeLimit": { "$ref": "#/definitions/kubernetesPositiveQuantity" }
      }
    },
    "runnerPlane": { "$ref": "#/definitions/runnerPlaneConfiguration" }
  },
  "definitions": {
    "kubernetesNonNegativeQuantity": {
      "type": "string",
      "pattern": "^\\+?(?:(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+|n|u|m|k|M|G|T|P|E|Ki|Mi|Gi|Ti|Pi|Ei)?$"
    },
    "kubernetesPositiveQuantity": {
      "type": "string",
      "pattern": "^\\+?(?:[1-9][0-9]*(?:\\.[0-9]+)?|0\\.[0-9]*[1-9][0-9]*|\\.[0-9]*[1-9][0-9]*)(?:[eE][+-]?[0-9]+|n|u|m|k|M|G|T|P|E|Ki|Mi|Gi|Ti|Pi|Ei)?$"
    },
    "resourceRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": { "$ref": "#/definitions/kubernetesNonNegativeQuantity" },
        "memory": { "$ref": "#/definitions/kubernetesNonNegativeQuantity" }
      }
    },
    "httpProbeTiming": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initialDelaySeconds", "periodSeconds"],
      "properties": {
        "initialDelaySeconds": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "periodSeconds": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
      }
    },
    "graphBlank": { "type": "string", "pattern": "^[\u0009-\u000D\u001C-\u0020\u1680\u2000-\u2006\u2008-\u200A\u2028-\u2029\u205F\u3000]*$" },
    "humanTaskBlank": { "type": "string", "pattern": "^[\u0009-\u000D\u001C-\u0020\u00A0\u1680\u2000-\u200A\u2028-\u2029\u202F\u205F\u3000]*$" },
    "positiveInt64MiB": {
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 67108864 },
        { "$ref": "#/definitions/humanTaskBlank" }
      ]
    },
    "positiveInt32": {
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        { "$ref": "#/definitions/humanTaskBlank" }
      ]
    },
    "nonNegativeEscalationSeconds": {
      "oneOf": [
        { "type": "integer", "minimum": 0, "maximum": 2147483646 },
        { "$ref": "#/definitions/humanTaskBlank" }
      ]
    },
    "positiveMillion": {
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 1000000 },
        { "$ref": "#/definitions/humanTaskBlank" }
      ]
    },
    "positiveFiveMillion": {
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 5000000 },
        { "$ref": "#/definitions/humanTaskBlank" }
      ]
    },
    "positive4096": {
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 4096 },
        { "$ref": "#/definitions/humanTaskBlank" }
      ]
    },
    "positive65536": { "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 65536 }, { "$ref": "#/definitions/humanTaskBlank" }] },
    "positive1048576": { "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 1048576 }, { "$ref": "#/definitions/humanTaskBlank" }] },
    "positive16384": { "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 16384 }, { "$ref": "#/definitions/humanTaskBlank" }] },
    "positive100": { "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 100 }, { "$ref": "#/definitions/humanTaskBlank" }] },
    "pollMillis": { "oneOf": [{ "type": "integer", "minimum": 250, "maximum": 300000 }, { "$ref": "#/definitions/humanTaskBlank" }] },
    "positive256": {
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 256 },
        { "$ref": "#/definitions/humanTaskBlank" }
      ]
    },
    "positive128": {
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 128 },
        { "$ref": "#/definitions/humanTaskBlank" }
      ]
    },
    "positive1000": {
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 1000 },
        { "$ref": "#/definitions/humanTaskBlank" }
      ]
    },
    "positive32": {
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 32 },
        { "$ref": "#/definitions/humanTaskBlank" }
      ]
    },
    "aiPositive": { "oneOf": [{ "type": "integer", "minimum": 1, "maximum": 2147483647 }, { "$ref": "#/definitions/graphBlank" }] },
    "aiConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultMaxTurns", "maxTurns", "maxMcpServers", "maxSkillPayloadBytes", "maxSkillNameChars", "maxSkillDescriptionChars", "maxSkillInstructionsChars", "maxMcpToolsPerServer", "defaultMaxDiscoveredMcpToolsPerServer", "maxDiscoveredMcpToolsPerServer", "maxLlmProfileBytes", "maxMcpProfileBytes", "defaultLlmTimeoutMs", "maxLlmTimeoutMs", "defaultMcpTimeoutMs", "maxMcpTimeoutMs", "defaultLlmRequestBytes", "maxLlmRequestBytes", "defaultLlmResponseBytes", "maxLlmResponseBytes", "defaultMcpRequestBytes", "maxMcpRequestBytes", "defaultMcpResponseBytes", "maxMcpResponseBytes", "defaultLlmConcurrency", "maxLlmConcurrency", "defaultMcpConcurrency", "maxMcpConcurrency", "maxSystemPreambleChars", "maxHttpDecompressionRatio", "maxModelInputProvenanceEntries"],
      "properties": {
        "defaultMaxTurns": { "x-ravenroot-environment": "RAVENROOT_AI_DEFAULT_MAX_TURNS", "$ref": "#/definitions/aiPositive" },
        "maxTurns": { "x-ravenroot-environment": "RAVENROOT_AI_MAX_TURNS", "$ref": "#/definitions/aiPositive" },
        "maxMcpServers": { "x-ravenroot-environment": "RAVENROOT_AI_MAX_MCP_SERVERS", "$ref": "#/definitions/aiPositive" },
        "maxSkillPayloadBytes": { "x-ravenroot-environment": "RAVENROOT_AI_MAX_SKILL_PAYLOAD_BYTES", "$ref": "#/definitions/aiPositive" },
        "maxSkillNameChars": { "x-ravenroot-environment": "RAVENROOT_AI_MAX_SKILL_NAME_CHARS", "$ref": "#/definitions/aiPositive" },
        "maxSkillDescriptionChars": { "x-ravenroot-environment": "RAVENROOT_AI_MAX_SKILL_DESCRIPTION_CHARS", "$ref": "#/definitions/aiPositive" },
        "maxSkillInstructionsChars": { "x-ravenroot-environment": "RAVENROOT_AI_MAX_SKILL_INSTRUCTIONS_CHARS", "$ref": "#/definitions/aiPositive" },
        "maxMcpToolsPerServer": { "x-ravenroot-environment": "RAVENROOT_AI_MAX_MCP_TOOLS_PER_SERVER", "$ref": "#/definitions/aiPositive" },
        "defaultMaxDiscoveredMcpToolsPerServer": { "x-ravenroot-environment": "RAVENROOT_AI_DEFAULT_MAX_DISCOVERED_MCP_TOOLS_PER_SERVER", "$ref": "#/definitions/aiPositive" },
        "maxDiscoveredMcpToolsPerServer": { "x-ravenroot-environment": "RAVENROOT_AI_MAX_DISCOVERED_MCP_TOOLS_PER_SERVER", "$ref": "#/definitions/aiPositive" },
        "maxLlmProfileBytes": { "x-ravenroot-environment": "RAVENROOT_AI_MAX_LLM_PROFILE_BYTES", "$ref": "#/definitions/aiPositive" },
        "maxMcpProfileBytes": { "x-ravenroot-environment": "RAVENROOT_AI_MAX_MCP_PROFILE_BYTES", "$ref": "#/definitions/aiPositive" },
        "defaultLlmTimeoutMs": { "x-ravenroot-environment": "RAVENROOT_AI_DEFAULT_LLM_TIMEOUT_MS", "$ref": "#/definitions/aiPositive" },
        "maxLlmTimeoutMs": { "x-ravenroot-environment": "RAVENROOT_AI_MAX_LLM_TIMEOUT_MS", "$ref": "#/definitions/aiPositive" },
        "defaultMcpTimeoutMs": { "x-ravenroot-environment": "RAVENROOT_AI_DEFAULT_MCP_TIMEOUT_MS", "$ref": "#/definitions/aiPositive" },
        "maxMcpTimeoutMs": { "x-ravenroot-environment": "RAVENROOT_AI_MAX_MCP_TIMEOUT_MS", "$ref": "#/definitions/aiPositive" },
        "defaultLlmRequestBytes": { "x-ravenroot-environment": "RAVENROOT_AI_DEFAULT_LLM_REQUEST_BYTES", "$ref": "#/definitions/aiPositive" },
        "maxLlmRequestBytes": { "x-ravenroot-environment": "RAVENROOT_AI_MAX_LLM_REQUEST_BYTES", "$ref": "#/definitions/aiPositive" },
        "defaultLlmResponseBytes": { "x-ravenroot-environment": "RAVENROOT_AI_DEFAULT_LLM_RESPONSE_BYTES", "$ref": "#/definitions/aiPositive" },
        "maxLlmResponseBytes": { "x-ravenroot-environment": "RAVENROOT_AI_MAX_LLM_RESPONSE_BYTES", "$ref": "#/definitions/aiPositive" },
        "defaultMcpRequestBytes": { "x-ravenroot-environment": "RAVENROOT_AI_DEFAULT_MCP_REQUEST_BYTES", "$ref": "#/definitions/aiPositive" },
        "maxMcpRequestBytes": { "x-ravenroot-environment": "RAVENROOT_AI_MAX_MCP_REQUEST_BYTES", "$ref": "#/definitions/aiPositive" },
        "defaultMcpResponseBytes": { "x-ravenroot-environment": "RAVENROOT_AI_DEFAULT_MCP_RESPONSE_BYTES", "$ref": "#/definitions/aiPositive" },
        "maxMcpResponseBytes": { "x-ravenroot-environment": "RAVENROOT_AI_MAX_MCP_RESPONSE_BYTES", "$ref": "#/definitions/aiPositive" },
        "defaultLlmConcurrency": { "x-ravenroot-environment": "RAVENROOT_AI_DEFAULT_LLM_CONCURRENCY", "$ref": "#/definitions/aiPositive" },
        "maxLlmConcurrency": { "x-ravenroot-environment": "RAVENROOT_AI_MAX_LLM_CONCURRENCY", "$ref": "#/definitions/aiPositive" },
        "defaultMcpConcurrency": { "x-ravenroot-environment": "RAVENROOT_AI_DEFAULT_MCP_CONCURRENCY", "$ref": "#/definitions/aiPositive" },
        "maxMcpConcurrency": { "x-ravenroot-environment": "RAVENROOT_AI_MAX_MCP_CONCURRENCY", "$ref": "#/definitions/aiPositive" },
        "maxSystemPreambleChars": { "x-ravenroot-environment": "RAVENROOT_AI_MAX_SYSTEM_PREAMBLE_CHARS", "$ref": "#/definitions/aiPositive" },
        "maxHttpDecompressionRatio": { "x-ravenroot-environment": "RAVENROOT_AI_MAX_HTTP_DECOMPRESSION_RATIO", "$ref": "#/definitions/aiPositive" },
        "maxModelInputProvenanceEntries": { "x-ravenroot-environment": "RAVENROOT_AI_MAX_MODEL_INPUT_PROVENANCE_ENTRIES", "$ref": "#/definitions/aiPositive" }
      }
    },
    "runnerPlaneConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "configMap", "sharedEnvironmentSecret", "artifactClaim", "coordinatorReplicas", "coordinatorPort", "coordinatorHttpThreads", "coordinatorHttpQueue", "coordinatorResources", "workerPools"],
      "properties": {
        "enabled": {"type": "boolean"},
        "configMap": {"type": "string"},
        "sharedEnvironmentSecret": {"type": "string"},
        "artifactClaim": {"type": "string"},
        "coordinatorReplicas": {"type": "integer", "minimum": 1},
        "coordinatorPort": {"type": "integer", "minimum": 1, "maximum": 65535},
        "coordinatorHttpThreads": {"type": "integer", "minimum": 1},
        "coordinatorHttpQueue": {"type": "integer", "minimum": 1},
        "coordinatorResources": {"$ref": "#/properties/resources"},
        "workerPools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "driver", "replicas", "image", "configMap", "identitySecret", "modelSecret", "nodeSelector", "stateSize", "storageClass", "resources"],
            "allOf": [
              {"if": {"properties": {"driver": {"const": "docker"}}}, "then": {"required": ["socketHostPath"], "not": {"required": ["kubernetes"]}}},
              {"if": {"properties": {"driver": {"const": "kubernetes"}}}, "then": {"required": ["kubernetes"], "not": {"required": ["socketHostPath"]}}}
            ],
            "properties": {
              "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"},
              "driver": {"type": "string", "enum": ["docker", "kubernetes"]},
              "replicas": {"type": "integer", "minimum": 0},
              "image": {"type": "string", "pattern": "^.+@sha256:[a-f0-9]{64}$"},
              "configMap": {"type": "string", "minLength": 1},
              "identitySecret": {"type": "string", "minLength": 1},
              "modelSecret": {"type": "string", "minLength": 1},
              "socketHostPath": {"type": "string", "pattern": "^/"},
              "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
              "kubernetes": {
                "type": "object", "additionalProperties": false,
                "required": ["namespace", "agentServiceAccount", "runtimeImages", "runtimeClassName", "maxPods", "maxClaims", "storageQuota"],
                "properties": {
                  "namespace": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,61}[a-z0-9]$"},
                  "agentServiceAccount": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,61}[a-z0-9]$"},
                  "runtimeClassName": {"type": "string", "pattern": "^$|^[a-z][a-z0-9-]{0,61}[a-z0-9]$"},
                  "runtimeImages": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
                    "items": {"type": "string", "pattern": "^.+@sha256:[a-f0-9]{64}$"}},
                  "maxPods": {"type": "integer", "minimum": 1},
                  "maxClaims": {"type": "integer", "minimum": 1},
                  "storageQuota": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"}
                }
              },
              "stateSize": {"type": "string", "minLength": 1},
              "storageClass": {"type": "string"},
              "resources": {"$ref": "#/properties/resources"}
            }
          }
        }
      }
    }
  }
}
