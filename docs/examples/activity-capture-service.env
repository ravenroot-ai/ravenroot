# Optional durable node-content archive. Restart the Service after changing these values.
RAVENROOT_ACTIVITY_CAPTURE_ENABLED=true
RAVENROOT_ACTIVITY_CAPTURE_POLICY=BEST_EFFORT
RAVENROOT_ACTIVITY_CAPTURE_NODES=payments,fulfilment
RAVENROOT_ACTIVITY_CAPTURE_CONTENTS=INPUT_PAYLOAD,OUTPUT_PAYLOAD
RAVENROOT_ACTIVITY_CAPTURE_MAX_PAYLOAD_BYTES=65536
RAVENROOT_ACTIVITY_CAPTURE_MAX_IN_FLIGHT=64
RAVENROOT_ACTIVITY_CAPTURE_WRITE_TIMEOUT_MILLIS=2000
RAVENROOT_ACTIVITY_CAPTURE_RETENTION_SECONDS=604800
RAVENROOT_ACTIVITY_CAPTURE_MAX_PAGE_SIZE=100
RAVENROOT_ACTIVITY_CAPTURE_REDACT_KEYS=password,secret,token,authorization,api_key,apikey
