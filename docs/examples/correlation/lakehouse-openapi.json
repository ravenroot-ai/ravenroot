                    "type": "string",
                    "maxLength": 64
                  },
                  "filename": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "version": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "round": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "stage": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "partition": {
                    "type": "string",
                    "maxLength": 64
                  }
                },
                "required": [
                  "ingestionId",
                  "filename",
                  "version",
                  "round",
                  "stage",
                  "partition"
                ],
                "additionalProperties": false
