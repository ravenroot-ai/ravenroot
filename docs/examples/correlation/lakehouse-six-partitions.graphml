<?xml version="1.0" encoding="UTF-8"?>
<!-- Replace localhost:19090 with the explicitly authorized external fixture/service endpoint. -->
<graphml xmlns="http://graphml.graphdrawing.org/xmlns">
<key id="kind" for="node" attr.name="kind" attr.type="string"/>
<key id="behavior" for="node" attr.name="behavior" attr.type="string"/>
<key id="apiProfile" for="node" attr.name="apiProfile" attr.type="string"/>
<key id="operations" for="node" attr.name="operations" attr.type="string"/>
