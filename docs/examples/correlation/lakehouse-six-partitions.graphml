<key id="method" for="node" attr.name="method" attr.type="string"/>
<key id="body" for="node" attr.name="body" attr.type="string"/>
<key id="correlation.mode" for="node" attr.name="correlation.mode" attr.type="string"/>
<key id="correlation.selector" for="node" attr.name="correlation.selector" attr.type="string"/>
<key id="correlation.secondarySelector" for="node" attr.name="correlation.secondarySelector" attr.type="string"/>
<key id="correlation.contributionSelector" for="node" attr.name="correlation.contributionSelector" attr.type="string"/>
<key id="correlation.kindSelector" for="node" attr.name="correlation.kindSelector" attr.type="string"/>
<key id="correlation.roundSelector" for="node" attr.name="correlation.roundSelector" attr.type="string"/>
<key id="correlation.referenceSelector" for="node" attr.name="correlation.referenceSelector" attr.type="string"/>
