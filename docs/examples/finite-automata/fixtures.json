  {
    "name": "binary parity",
    "definition": {
      "schema": "ravenroot.finite-automaton/v1",
      "kind": "dfa",
      "states": [
        "even",
        "odd"
      ],
      "alphabet": [
        "0",
        "1"
      ],
      "initialStates": [
        "even"
      ],
      "acceptingStates": [
        "even"
      ],
      "transitions": [
        {
          "from": "even",
          "on": "0",
          "to": "even"
        },
        {
          "from": "even",
          "on": "1",
          "to": "odd"
        },
        {
          "from": "odd",
          "on": "0",
          "to": "odd"
        },
        {
          "from": "odd",
          "on": "1",
          "to": "even"
        }
      ],
      "transitionPolicy": "total"
    },
    "input": [
      "1",
      "0",
      "1"
    ],
    "expected": {
      "accepted": true,
      "finalStates": [
        "even"
      ],
      "consumed": 3,
      "output": [],
      "steps": 6
    }
  },
