<?xml version="1.0" encoding="UTF-8"?>
<!-- Admission-ready system-one-evaluate graph. Supply an input payload at execution.
     Replace any replace-with-operator-profile value with a configured profile before Run.
     Success reaches end through the documented descriptor outcome; failure reaches error. -->
<graphml xmlns="http://graphml.graphdrawing.org/xmlns">
  <key id="kind" for="node" attr.name="kind" attr.type="string"/>
  <key id="behavior" for="node" attr.name="behavior" attr.type="string"/>
  <key id="outcome" for="edge" attr.name="outcome" attr.type="string"/>
  <key id="property-profile" for="node" attr.name="profile" attr.type="string"/>
  <key id="property-specification" for="node" attr.name="specification" attr.type="string"/>
  <graph id="example-system-one-evaluate" edgedefault="directed">
    <node id="start"><data key="kind">START</data></node>
    <node id="action">
      <data key="kind">BEHAVIOR</data>
      <data key="behavior">system-one-evaluate</data>
      <data key="property-profile">replace-with-operator-profile</data>
      <data key="property-specification">{&quot;contract&quot;:&quot;ravenroot.system-one/specification/1&quot;,&quot;id&quot;:&quot;example/v1&quot;,&quot;questions&quot;:{&quot;category&quot;:{&quot;type&quot;:&quot;choice&quot;,&quot;instructions&quot;:&quot;Classify the state.&quot;,&quot;criteria&quot;:{&quot;accept&quot;:null,&quot;review&quot;:null}},&quot;uncertain&quot;:{&quot;type&quot;:&quot;noul&quot;,&quot;instructions&quot;:&quot;Is the state uncertain?&quot;},&quot;score&quot;:{&quot;type&quot;:&quot;score&quot;,&quot;instructions&quot;:&quot;Score from low to high.&quot;,&quot;criteria&quot;:[&quot;low&quot;,&quot;high&quot;]}}}</data>
    </node>
    <node id="end"><data key="kind">END</data></node>
    <node id="error"><data key="kind">ERROR</data></node>
    <edge id="start-action" source="start" target="action"><data key="outcome">continue</data></edge>
    <edge id="action-end-0" source="action" target="end"><data key="outcome">continue</data></edge>
    <edge id="action-error" source="action" target="error"/>
  </graph>
</graphml>
