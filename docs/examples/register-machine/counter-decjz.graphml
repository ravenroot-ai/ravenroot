<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns">
  <key id="g-join" for="graph" attr.name="join.semantics" attr.type="string"/>
  <key id="kind" for="node" attr.name="kind" attr.type="string"/><key id="behavior" for="node" attr.name="behavior" attr.type="string"/>
  <key id="operation" for="node" attr.name="operation" attr.type="string"/><key id="left" for="node" attr.name="left" attr.type="string"/>
  <key id="right" for="node" attr.name="right" attr.type="string"/><key id="target" for="node" attr.name="target" attr.type="string"/>
  <key id="expression" for="node" attr.name="expression" attr.type="string"/><key id="true" for="node" attr.name="trueOutcome" attr.type="string"/>
  <key id="false" for="node" attr.name="falseOutcome" attr.type="string"/><key id="outcome" for="edge" attr.name="outcome" attr.type="string"/>
  <graph id="register-counter-decjz" edgedefault="directed"><data key="g-join">declared</data>
    <node id="start"><data key="kind">START</data></node>
    <node id="set"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">copy</data><data key="left">literal:3</data><data key="target">counter</data></node>
    <node id="zero-test"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">equal</data><data key="left">field:counter</data><data key="right">literal:0</data><data key="target">isZero</data></node>
    <node id="branch"><data key="kind">BEHAVIOR</data><data key="behavior">cel-decision</data><data key="expression">payload.isZero</data><data key="true">zero</data><data key="false">nonzero</data></node>
    <node id="decrement"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">subtract</data><data key="left">field:counter</data><data key="right">literal:1</data><data key="target">counter</data></node>
    <node id="end"><data key="kind">END</data></node>
    <edge id="e0" source="start" target="set"/><edge id="e1" source="set" target="zero-test"/><edge id="e2" source="zero-test" target="branch"/>
    <edge id="e3" source="branch" target="end"><data key="outcome">zero</data></edge><edge id="e4" source="branch" target="decrement"><data key="outcome">nonzero</data></edge><edge id="e5" source="decrement" target="zero-test"/>
  </graph>
</graphml>
