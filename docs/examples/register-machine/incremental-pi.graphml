<?xml version="1.0" encoding="UTF-8"?>
<!-- Unbounded Rabinowitz/Wagon-style spigot. Every arithmetic expression is one bigint-op node.
     Each visit to emit logs exactly one successive decimal digit; cancel externally to stop. -->
<graphml xmlns="http://graphml.graphdrawing.org/xmlns">
  <key id="g-join" for="graph" attr.name="join.semantics" attr.type="string"/><key id="kind" for="node" attr.name="kind" attr.type="string"/><key id="behavior" for="node" attr.name="behavior" attr.type="string"/><key id="operation" for="node" attr.name="operation" attr.type="string"/><key id="left" for="node" attr.name="left" attr.type="string"/><key id="right" for="node" attr.name="right" attr.type="string"/><key id="target" for="node" attr.name="target" attr.type="string"/><key id="expression" for="node" attr.name="expression" attr.type="string"/><key id="true" for="node" attr.name="trueOutcome" attr.type="string"/><key id="false" for="node" attr.name="falseOutcome" attr.type="string"/><key id="message" for="node" attr.name="message" attr.type="string"/><key id="outcome" for="edge" attr.name="outcome" attr.type="string"/>
  <graph id="register-incremental-pi" edgedefault="directed"><data key="g-join">declared</data>
    <node id="start"><data key="kind">START</data></node>
    <node id="q0"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">copy</data><data key="left">literal:1</data><data key="target">q</data></node>
    <node id="r0"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">copy</data><data key="left">literal:0</data><data key="target">r</data></node>
    <node id="t0"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">copy</data><data key="left">literal:1</data><data key="target">t</data></node>
    <node id="k0"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">copy</data><data key="left">literal:1</data><data key="target">k</data></node>
    <node id="n0"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">copy</data><data key="left">literal:3</data><data key="target">n</data></node>
    <node id="l0"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">copy</data><data key="left">literal:3</data><data key="target">l</data></node>

    <node id="c1"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">multiply</data><data key="left">literal:4</data><data key="right">field:q</data><data key="target">c1</data></node>
    <node id="c2"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">add</data><data key="left">field:c1</data><data key="right">field:r</data><data key="target">c2</data></node>
    <node id="c3"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">subtract</data><data key="left">field:c2</data><data key="right">field:t</data><data key="target">c3</data></node>
    <node id="c4"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">multiply</data><data key="left">field:n</data><data key="right">field:t</data><data key="target">c4</data></node>
    <node id="safe-digit"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">less-than</data><data key="left">field:c3</data><data key="right">field:c4</data><data key="target">safeDigit</data></node>
    <node id="branch"><data key="kind">BEHAVIOR</data><data key="behavior">cel-decision</data><data key="expression">payload.safeDigit</data><data key="true">emit</data><data key="false">refine</data></node>

    <node id="emit"><data key="kind">BEHAVIOR</data><data key="behavior">log</data><data key="message">pi digit={{payload.n}}</data></node>
    <node id="e1"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">multiply</data><data key="left">field:n</data><data key="right">field:t</data><data key="target">e1</data></node>
    <node id="e2"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">subtract</data><data key="left">field:r</data><data key="right">field:e1</data><data key="target">e2</data></node>
    <node id="e3"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">multiply</data><data key="left">literal:10</data><data key="right">field:e2</data><data key="target">newR</data></node>
    <node id="e4"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">multiply</data><data key="left">literal:3</data><data key="right">field:q</data><data key="target">e4</data></node>
    <node id="e5"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">add</data><data key="left">field:e4</data><data key="right">field:r</data><data key="target">e5</data></node>
    <node id="e6"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">multiply</data><data key="left">literal:10</data><data key="right">field:e5</data><data key="target">e6</data></node>
    <node id="e7"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">floor-divide</data><data key="left">field:e6</data><data key="right">field:t</data><data key="target">e7</data></node>
    <node id="e8"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">multiply</data><data key="left">literal:10</data><data key="right">field:n</data><data key="target">e8</data></node>
    <node id="e9"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">subtract</data><data key="left">field:e7</data><data key="right">field:e8</data><data key="target">newN</data></node>
    <node id="eq"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">multiply</data><data key="left">literal:10</data><data key="right">field:q</data><data key="target">newQ</data></node>
    <node id="set-eq"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">copy</data><data key="left">field:newQ</data><data key="target">q</data></node>
    <node id="set-er"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">copy</data><data key="left">field:newR</data><data key="target">r</data></node>
    <node id="set-en"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">copy</data><data key="left">field:newN</data><data key="target">n</data></node>

    <node id="f1"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">multiply</data><data key="left">literal:2</data><data key="right">field:q</data><data key="target">f1</data></node>
    <node id="f2"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">add</data><data key="left">field:f1</data><data key="right">field:r</data><data key="target">f2</data></node>
    <node id="f3"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">multiply</data><data key="left">field:f2</data><data key="right">field:l</data><data key="target">newR</data></node>
    <node id="f4"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">multiply</data><data key="left">literal:7</data><data key="right">field:k</data><data key="target">f4</data></node>
    <node id="f5"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">multiply</data><data key="left">field:q</data><data key="right">field:f4</data><data key="target">f5</data></node>
    <node id="f6"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">add</data><data key="left">field:f5</data><data key="right">literal:2</data><data key="target">f6</data></node>
    <node id="f7"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">multiply</data><data key="left">field:r</data><data key="right">field:l</data><data key="target">f7</data></node>
    <node id="f8"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">add</data><data key="left">field:f6</data><data key="right">field:f7</data><data key="target">f8</data></node>
    <node id="f9"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">multiply</data><data key="left">field:t</data><data key="right">field:l</data><data key="target">newT</data></node>
    <node id="f10"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">floor-divide</data><data key="left">field:f8</data><data key="right">field:newT</data><data key="target">newN</data></node>
    <node id="fq"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">multiply</data><data key="left">field:q</data><data key="right">field:k</data><data key="target">newQ</data></node>
    <node id="fl"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">add</data><data key="left">field:l</data><data key="right">literal:2</data><data key="target">newL</data></node>
    <node id="fk"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">add</data><data key="left">field:k</data><data key="right">literal:1</data><data key="target">newK</data></node>
    <node id="set-fq"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">copy</data><data key="left">field:newQ</data><data key="target">q</data></node>
    <node id="set-ft"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">copy</data><data key="left">field:newT</data><data key="target">t</data></node>
    <node id="set-fl"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">copy</data><data key="left">field:newL</data><data key="target">l</data></node>
    <node id="set-fk"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">copy</data><data key="left">field:newK</data><data key="target">k</data></node>
    <node id="set-fr"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">copy</data><data key="left">field:newR</data><data key="target">r</data></node>
    <node id="set-fn"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">copy</data><data key="left">field:newN</data><data key="target">n</data></node>
    <node id="end"><data key="kind">END</data></node>

    <edge id="i0" source="start" target="q0"/><edge id="i1" source="q0" target="r0"/><edge id="i2" source="r0" target="t0"/><edge id="i3" source="t0" target="k0"/><edge id="i4" source="k0" target="n0"/><edge id="i5" source="n0" target="l0"/><edge id="i6" source="l0" target="c1"/>
    <edge id="c01" source="c1" target="c2"/><edge id="c02" source="c2" target="c3"/><edge id="c03" source="c3" target="c4"/><edge id="c04" source="c4" target="safe-digit"/><edge id="c05" source="safe-digit" target="branch"/>
    <edge id="b0" source="branch" target="emit"><data key="outcome">emit</data></edge><edge id="b1" source="branch" target="f1"><data key="outcome">refine</data></edge>
    <edge id="e01" source="emit" target="e1"/><edge id="e02" source="e1" target="e2"/><edge id="e03" source="e2" target="e3"/><edge id="e04" source="e3" target="e4"/><edge id="e05" source="e4" target="e5"/><edge id="e06" source="e5" target="e6"/><edge id="e07" source="e6" target="e7"/><edge id="e08" source="e7" target="e8"/><edge id="e09" source="e8" target="e9"/><edge id="e10" source="e9" target="eq"/><edge id="e11" source="eq" target="set-eq"/><edge id="e12" source="set-eq" target="set-er"/><edge id="e13" source="set-er" target="set-en"/><edge id="e14" source="set-en" target="c1"/>
    <edge id="f01" source="f1" target="f2"/><edge id="f02" source="f2" target="f3"/><edge id="f03" source="f3" target="f4"/><edge id="f04" source="f4" target="f5"/><edge id="f05" source="f5" target="f6"/><edge id="f06" source="f6" target="f7"/><edge id="f07" source="f7" target="f8"/><edge id="f08" source="f8" target="f9"/><edge id="f09" source="f9" target="f10"/><edge id="f10a" source="f10" target="fq"/><edge id="f11" source="fq" target="fl"/><edge id="f12" source="fl" target="fk"/><edge id="f13" source="fk" target="set-fq"/><edge id="f14" source="set-fq" target="set-ft"/><edge id="f15" source="set-ft" target="set-fl"/><edge id="f16" source="set-fl" target="set-fk"/><edge id="f17" source="set-fk" target="set-fr"/><edge id="f18" source="set-fr" target="set-fn"/><edge id="f19" source="set-fn" target="c1"/>
  </graph>
</graphml>
