<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns">
  <key id="kind" for="node" attr.name="kind" attr.type="string"/><key id="behavior" for="node" attr.name="behavior" attr.type="string"/>
  <key id="operation" for="node" attr.name="operation" attr.type="string"/><key id="left" for="node" attr.name="left" attr.type="string"/>
  <key id="right" for="node" attr.name="right" attr.type="string"/><key id="target" for="node" attr.name="target" attr.type="string"/>
  <graph id="register-multiplication" edgedefault="directed">
    <node id="start"><data key="kind">START</data></node>
    <node id="set-left"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">copy</data><data key="left">literal:123456789</data><data key="target">left</data></node>
    <node id="set-right"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">copy</data><data key="left">literal:987654321</data><data key="target">right</data></node>
    <node id="multiply"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">multiply</data><data key="left">field:left</data><data key="right">field:right</data><data key="target">product</data></node>
    <node id="end"><data key="kind">END</data></node>
    <edge id="e0" source="start" target="set-left"/><edge id="e1" source="set-left" target="set-right"/><edge id="e2" source="set-right" target="multiply"/><edge id="e3" source="multiply" target="end"/>
  </graph>
</graphml>
