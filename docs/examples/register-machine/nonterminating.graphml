<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns">
  <key id="g-join" for="graph" attr.name="join.semantics" attr.type="string"/><key id="kind" for="node" attr.name="kind" attr.type="string"/><key id="behavior" for="node" attr.name="behavior" attr.type="string"/><key id="operation" for="node" attr.name="operation" attr.type="string"/><key id="left" for="node" attr.name="left" attr.type="string"/><key id="right" for="node" attr.name="right" attr.type="string"/><key id="target" for="node" attr.name="target" attr.type="string"/><key id="expression" for="node" attr.name="expression" attr.type="string"/><key id="true" for="node" attr.name="trueOutcome" attr.type="string"/><key id="false" for="node" attr.name="falseOutcome" attr.type="string"/><key id="outcome" for="edge" attr.name="outcome" attr.type="string"/>
  <graph id="register-nonterminating" edgedefault="directed"><data key="g-join">declared</data>
    <node id="start"><data key="kind">START</data></node>
    <node id="set"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">copy</data><data key="left">literal:0</data><data key="target">counter</data></node>
    <node id="increment"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">add</data><data key="left">field:counter</data><data key="right">literal:1</data><data key="target">counter</data></node>
    <node id="impossible"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">less-than</data><data key="left">field:counter</data><data key="right">literal:0</data><data key="target">isNegative</data></node>
    <node id="branch"><data key="kind">BEHAVIOR</data><data key="behavior">cel-decision</data><data key="expression">payload.isNegative</data><data key="true">done</data><data key="false">again</data></node>
    <node id="end"><data key="kind">END</data></node><edge id="e0" source="start" target="set"/><edge id="e1" source="set" target="increment"/><edge id="e2" source="increment" target="impossible"/><edge id="e3" source="impossible" target="branch"/><edge id="e4" source="branch" target="end"><data key="outcome">done</data></edge><edge id="e5" source="branch" target="increment"><data key="outcome">again</data></edge>
  </graph>
</graphml>
