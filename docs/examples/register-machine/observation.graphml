<?xml version="1.0" encoding="UTF-8"?>
<graphml xmlns="http://graphml.graphdrawing.org/xmlns">
  <key id="kind" for="node" attr.name="kind" attr.type="string"/><key id="behavior" for="node" attr.name="behavior" attr.type="string"/><key id="operation" for="node" attr.name="operation" attr.type="string"/><key id="left" for="node" attr.name="left" attr.type="string"/><key id="right" for="node" attr.name="right" attr.type="string"/><key id="target" for="node" attr.name="target" attr.type="string"/><key id="message" for="node" attr.name="message" attr.type="string"/>
  <graph id="register-observation" edgedefault="directed">
    <node id="start"><data key="kind">START</data></node>
    <node id="set"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">copy</data><data key="left">literal:40</data><data key="target">counter</data></node>
    <node id="increment"><data key="kind">BEHAVIOR</data><data key="behavior">bigint-op</data><data key="operation">add</data><data key="left">field:counter</data><data key="right">literal:1</data><data key="target">counter</data></node>
    <node id="observe"><data key="kind">BEHAVIOR</data><data key="behavior">log</data><data key="message">counter={{payload.counter}}</data></node>
    <node id="end"><data key="kind">END</data></node><edge id="e0" source="start" target="set"/><edge id="e1" source="set" target="increment"/><edge id="e2" source="increment" target="observe"/><edge id="e3" source="observe" target="end"/>
  </graph>
</graphml>
