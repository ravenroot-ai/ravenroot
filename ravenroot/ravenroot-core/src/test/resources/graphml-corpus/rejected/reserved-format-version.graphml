<?xml version="1.0" encoding="UTF-8"?>
<!--
  A document that declares a Ravenroot format version as node content.

  The key is the one a future profile marker would use, so this fixture pins what profile 0 does
  with it TODAY, before any format-version marker exists. SEC-09 reserves the whole 'ravenroot.' namespace as
  Ravenroot's own operative state, so graph content claiming it is refused at ingest rather than
  preserved. Introducing a format-version marker requires moving this file out of rejected/ and
  explicitly updating the compatibility boundary instead of quietly reversing the behaviour.
-->
<graphml xmlns="http://graphml.graphdrawing.org/xmlns">
  <key id="n-kind" for="node" attr.name="kind" attr.type="string"/>
  <key id="n-format-version" for="node" attr.name="ravenroot.format.version" attr.type="int"/>
  <graph id="reserved-format-version" edgedefault="directed">
    <node id="start">
      <data key="n-kind">START</data>
      <data key="n-format-version">1</data>
    </node>
    <node id="end">
      <data key="n-kind">END</data>
    </node>
    <edge id="edge-start-end" source="start" target="end"/>
  </graph>
</graphml>
