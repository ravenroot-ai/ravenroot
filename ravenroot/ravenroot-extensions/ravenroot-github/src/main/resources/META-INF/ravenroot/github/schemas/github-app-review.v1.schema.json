{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:ravenroot:github:github-app-review:v1",
  "$defs":{
    "input":{"type":"object","additionalProperties":false,"required":["version","pullNumber","commit","verdict","body","correlationId"],"properties":{"version":{"const":"github.app-review.v1"},"pullNumber":{"type":"integer","minimum":1,"maximum":2147483647},"commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},"verdict":{"enum":["APPROVE","REQUEST_CHANGES","COMMENT"]},"body":{"type":"string","maxLength":8192},"correlationId":{"type":"string","minLength":1,"maxLength":128}}},
    "output":{"type":"object","additionalProperties":false,"required":["version","status","pullNumber","commit","verdict","remoteId","generation","attempts"],"properties":{"version":{"const":"github.app-review.result.v1"},"status":{"type":"string"},"pullNumber":{"type":"integer"},"commit":{"type":"string"},"verdict":{"type":"string"},"remoteId":{"type":"string"},"generation":{"type":"integer"},"attempts":{"type":"integer"},"reason":{"type":"string"},"retryAtEpochMs":{"type":"integer"}}}
  }
}
