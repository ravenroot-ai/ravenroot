{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:ravenroot:github:github-workflow-watch:v1",
  "$defs":{
    "input":{"type":"object","additionalProperties":false,"required":["version","commit","deadlineEpochMs","correlationId"],"properties":{"version":{"const":"github.workflow-watch.v1"},"commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},"deadlineEpochMs":{"type":"integer","minimum":1},"correlationId":{"type":"string","minLength":1,"maxLength":128}}},
    "run":{"type":"object","additionalProperties":false,"required":["workflowId","runId","runNumber","attempt","createdAt","status","conclusion"],"properties":{"workflowId":{"type":"integer","minimum":1},"runId":{"type":"integer","minimum":1},"runNumber":{"type":"integer","minimum":1},"attempt":{"type":"integer","minimum":1},"createdAt":{"type":"string","format":"date-time"},"status":{"type":"string"},"conclusion":{"type":"string"}}},
    "result":{"type":"object","additionalProperties":false,"required":["version","status","commit","polls","workflows","generation","attempts","remoteId"],"properties":{"version":{"const":"github.workflow-watch.result.v1"},"status":{"type":"string"},"commit":{"type":"string"},"polls":{"type":"integer"},"workflows":{"type":"array","items":{"$ref":"#/$defs/run"}},"generation":{"type":"integer"},"attempts":{"type":"integer"},"remoteId":{"type":"string"},"reason":{"type":"string"},"retryAtEpochMs":{"type":"integer"}}},
    "retry":{"type":"object","additionalProperties":false,"required":["version","status","reason","retryAtEpochMs","generation","attempts","remoteId"],"properties":{"version":{"const":"github.operation.retry.v1"},"status":{"const":"waiting"},"reason":{"const":"RATE_LIMITED"},"retryAtEpochMs":{"type":"integer","minimum":1},"generation":{"type":"integer"},"attempts":{"type":"integer"},"remoteId":{"type":"string"}}},
    "output":{"oneOf":[{"$ref":"#/$defs/result"},{"$ref":"#/$defs/retry"}]}
  }
}
