{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:ravenroot:github:release-prepare:v1",
  "$defs":{
    "input":{"type":"object","additionalProperties":false,"required":["version","commit","releaseKind","correlationId"],"properties":{"version":{"const":"github.release-prepare.v1"},"commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},"releaseKind":{"enum":["none","patch","minor","major"]},"correlationId":{"type":"string","minLength":1,"maxLength":128}}},
    "fragment":{"type":"object","additionalProperties":false,"required":["name","kind","text","sha256"],"properties":{"name":{"type":"string"},"kind":{"enum":["breaking","feature","security","fix","docs","other"]},"text":{"type":"string"},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
    "output":{"type":"object","additionalProperties":false,"required":["version","status","sourceCommit","currentVersion","nextVersion","tag","releaseKind","highestFragmentKind","fragments","sourceVersionSha256","generation","attempts","remoteId"],"properties":{"version":{"const":"github.release-prepare.result.v1"},"status":{"const":"prepared"},"sourceCommit":{"type":"string"},"currentVersion":{"type":"string"},"nextVersion":{"type":"string"},"tag":{"type":"string"},"releaseKind":{"type":"string"},"highestFragmentKind":{"type":"string"},"fragments":{"type":"array","items":{"$ref":"#/$defs/fragment"}},"sourceVersionSha256":{"type":"string"},"generation":{"type":"integer"},"attempts":{"type":"integer"},"remoteId":{"type":"string"}}}
  }
}
