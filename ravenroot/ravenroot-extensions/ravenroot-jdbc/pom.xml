<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"><modelVersion>4.0.0</modelVersion>
 <parent><groupId>ai.ravenroot</groupId><artifactId>ravenroot-parent</artifactId><version>0.4.1-alpha.1</version><relativePath>../../pom.xml</relativePath></parent>
 <artifactId>ravenroot-jdbc</artifactId><name>Ravenroot profiled JDBC extension</name><dependencies>
  <dependency><groupId>ai.ravenroot</groupId><artifactId>ravenroot-application-api</artifactId></dependency>
  <dependency><groupId>ai.ravenroot</groupId><artifactId>ravenroot-plugin-bundle</artifactId><scope>test</scope></dependency>
  <dependency><groupId>ai.ravenroot</groupId><artifactId>ravenroot-api-testkit</artifactId><version>${project.version}</version><scope>test</scope></dependency>
  <!-- Actual operator-driver fixture only, checksum-pinned by JdbcDriverBundleEndToEndTest and by
       JdbcMultiReleaseVendorDriverTest, and never part of the plugin or default distribution
       runtime classpath. It reads the parent's postgresql-jdbc.version, so the extension exercises
       the same driver the runtime persistence adapter ships. That artifact is a multi-release jar,
       which the driver loader resolves once into a verified flat image; both tests pin its exact
       SHA-256, so moving this property to a driver of another shape fails loudly instead of
       silently changing what they prove. -->
  <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><version>${postgresql-jdbc.version}</version><scope>test</scope></dependency>
  <!-- The unversioned half of the loader contract: MySQL Connector/J publishes no versioned
       entries, so JdbcDriverBundleEndToEndTest covers a real vendor jar that is one flat image. -->
  <dependency><groupId>com.mysql</groupId><artifactId>mysql-connector-j</artifactId><version>26.7.0</version><scope>test</scope></dependency>
  <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
 </dependencies></project>
