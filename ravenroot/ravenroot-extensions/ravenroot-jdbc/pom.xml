<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"><modelVersion>4.0.0</modelVersion>
 <parent><groupId>ai.ravenroot</groupId><artifactId>ravenroot-parent</artifactId><version>0.4.1-alpha.1</version><relativePath>../../pom.xml</relativePath></parent>
 <artifactId>ravenroot-jdbc</artifactId><name>Ravenroot profiled JDBC extension</name><dependencies>
  <dependency><groupId>ai.ravenroot</groupId><artifactId>ravenroot-application-api</artifactId></dependency>
  <dependency><groupId>ai.ravenroot</groupId><artifactId>ravenroot-plugin-bundle</artifactId><scope>test</scope></dependency>
  <dependency><groupId>ai.ravenroot</groupId><artifactId>ravenroot-api-testkit</artifactId><version>${project.version}</version><scope>test</scope></dependency>
  <!-- Actual operator-driver fixture only. It is checksum-pinned by JdbcDriverBundleEndToEndTest
       and never enters the plugin or default distribution runtime classpath.
       Pinned here on purpose instead of reading the parent's postgresql-jdbc.version, which the
       runtime persistence adapter uses: the 42.7.12 driver is a multi-release jar, and
       JdbcDriverLoader deliberately refuses multi-release driver jars. This fixture stays on the
       flat 42.7.7 jar until #280 teaches the loader multi-release jars; moving it earlier only
       reproduces that refusal. -->
  <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><version>42.7.7</version><scope>test</scope></dependency>
  <dependency><groupId>com.mysql</groupId><artifactId>mysql-connector-j</artifactId><version>9.5.0</version><scope>test</scope></dependency>
  <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
 </dependencies></project>
