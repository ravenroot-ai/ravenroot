<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>ai.ravenroot</groupId>
        <artifactId>ravenroot-parent</artifactId>
        <version>0.2.0-alpha.1</version>
    </parent>
    <artifactId>ravenroot-server</artifactId>
    <name>Ravenroot Server</name>
    <description>Standalone HTTP adapter and composition root.</description>
    <properties>
        <!--
            This module creates bare JDK HttpServer fixtures. Set the process-wide request-header cap
            before the reused Surefire fork loads any server class by populating the parent's
            composable extra-argument property; the inherited argLine still appends the locale pin.
        -->
        <ravenroot.surefire.extraArgLine>-Dsun.net.httpserver.maxReqHeaderSize=2097152</ravenroot.surefire.extraArgLine>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
            <version>${nimbus-jose-jwt.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty.websocket</groupId>
            <artifactId>jetty-websocket-jetty-server</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.ravenroot</groupId>
            <artifactId>ravenroot-application-api</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.ravenroot</groupId>
            <artifactId>ravenroot-core</artifactId>
        </dependency>
        <!-- PluginBundleLoader and the classes it returns. -->
        <dependency>
            <groupId>ai.ravenroot</groupId>
            <artifactId>ravenroot-plugin-bundle</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.ravenroot</groupId>
            <artifactId>ravenroot-programming-graalvm</artifactId>
        </dependency>
        <!-- The OpenTelemetry bridge, disabled unless
             RAVENROOT_OTEL_ENABLED=true. -->
        <dependency>
            <groupId>ai.ravenroot</groupId>
            <artifactId>ravenroot-observability-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.ravenroot</groupId>
            <artifactId>ravenroot-persistence-sqlite</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
            The shared adapter, so a deployment can select it without rebuilding. It ships alongside
            the single-host one rather than instead of it: which store runs is a deployment's choice
            at startup, and a choice the operator cannot express is not a choice.
        -->
        <dependency>
            <groupId>ai.ravenroot</groupId>
            <artifactId>ravenroot-persistence-postgresql</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--
            The connection pool for the shared store, and the only module that names it. The adapter
            deliberately does not pool - it is handed a DataSource - so the pool belongs to the
            composition root, where the deployment's own sizing is already known.
        -->
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
        </dependency>
        <!--
            The shared-store smoke test opens a server against a real PostgreSQL through the new
            selection seam. The adapter's own fixture is package-private in its test sources and that
            module publishes no test jar, so this container is started here rather than that logic
            being copied.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ai.ravenroot</groupId>
            <artifactId>ravenroot-pekko</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ai.ravenroot</groupId>
            <artifactId>ravenroot-api-testkit</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The engine-adapter kill cell reuses KillMatrixArtifact rather than growing a
             second copy. Test-scoped: nothing shipped depends on it. -->
        <dependency>
            <groupId>ai.ravenroot</groupId>
            <artifactId>ravenroot-persistence-testkit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                        The engine-adapter kill cell forks a real second JVM and hands it
                        this JVM's classpath, the same reason ravenroot-persistence-sqlite's pom
                        already disables the manifest-only booter jar; see that pom for the full
                        explanation. A SIGKILL, not a classloading accident, must be what ends the child.
                    -->
                    <useManifestOnlyJar>false</useManifestOnlyJar>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
