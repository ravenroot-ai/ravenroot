<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>ai.ravenroot</groupId>
        <artifactId>ravenroot-parent</artifactId>
        <version>0.1.0-alpha.1</version>
    </parent>
    <artifactId>ravenroot-server</artifactId>
    <name>Ravenroot Server</name>
    <description>Standalone HTTP adapter and composition root.</description>
    <dependencies>
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
            <version>${nimbus-jose-jwt.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.ravenroot</groupId>
            <artifactId>ravenroot-application-api</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.ravenroot</groupId>
            <artifactId>ravenroot-core</artifactId>
        </dependency>
        <!-- PluginBundleLoader and the classes it returns. -->
        <dependency>
            <groupId>ai.ravenroot</groupId>
            <artifactId>ravenroot-plugin-bundle</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.ravenroot</groupId>
            <artifactId>ravenroot-programming-graalvm</artifactId>
        </dependency>
        <!-- The OpenTelemetry bridge, disabled unless
             RAVENROOT_OTEL_ENABLED=true. -->
        <dependency>
            <groupId>ai.ravenroot</groupId>
            <artifactId>ravenroot-observability-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>ai.ravenroot</groupId>
            <artifactId>ravenroot-persistence-sqlite</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>ai.ravenroot</groupId>
            <artifactId>ravenroot-pekko</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ai.ravenroot</groupId>
            <artifactId>ravenroot-api-testkit</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The engine-adapter kill cell reuses KillMatrixArtifact rather than growing a
             second copy. Test-scoped: nothing shipped depends on it. -->
        <dependency>
            <groupId>ai.ravenroot</groupId>
            <artifactId>ravenroot-persistence-testkit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                        The engine-adapter kill cell forks a real second JVM and hands it
                        this JVM's classpath, the same reason ravenroot-persistence-sqlite's pom
                        already disables the manifest-only booter jar; see that pom for the full
                        explanation. A SIGKILL, not a classloading accident, must be what ends the child.
                    -->
                    <useManifestOnlyJar>false</useManifestOnlyJar>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
