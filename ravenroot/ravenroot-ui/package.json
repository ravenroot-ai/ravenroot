{
  "name": "@ravenroot/ui",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Framework-independent GraphML and Graphify graph viewer for Ravenroot.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:fuzz": "vitest run --config vitest.fuzz.config.js",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:embed": "npm run build && mvn -f ../pom.xml -pl ravenroot-server -am -Dravenroot.embed.browserTest=true -Dtest=EmbedBrowserPlaywrightIntegrationTest -Dsurefire.failIfNoSpecifiedTests=false test"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "cytoscape": "3.34.0",
    "cytoscape-dagre": "4.0.0",
    "cytoscape-elk": "2.3.0",
    "cytoscape-euler": "1.2.4",
    "d3": "7.9.0",
    "dagre": "0.8.5",
    "elkjs": "0.9.3",
    "web-worker": "1.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.0",
    "fast-check": "4.9.0",
    "jsdom": "29.1.1",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true
  }
}
