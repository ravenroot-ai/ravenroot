<graphml xmlns="http://graphml.graphdrawing.org/xmlns"><key id="rr-graph-join-semantics" for="graph" attr.name="join.semantics" attr.type="string"/><key id="rr-node-name" for="node" attr.name="name" attr.type="string"/><key id="rr-node-kind" for="node" attr.name="kind" attr.type="string"/><key id="rr-node-classification" for="node" attr.name="classification" attr.type="string"/><key id="rr-node-layoutx" for="node" attr.name="layoutX" attr.type="double"/><key id="rr-node-layouty" for="node" attr.name="layoutY" attr.type="double"/><key id="rr-node-layoutwidth" for="node" attr.name="layoutWidth" attr.type="double"/><key id="rr-node-layoutheight" for="node" attr.name="layoutHeight" attr.type="double"/><key id="rr-edge-outcome" for="edge" attr.name="outcome" attr.type="string"/><key id="rr-edge-status" for="edge" attr.name="status" attr.type="int"/><key id="rr-edge-parallel" for="edge" attr.name="parallel" attr.type="boolean"/><key id="rr-edge-slaminutes" for="edge" attr.name="slaMinutes" attr.type="int"/><key id="rr-edge-name" for="edge" attr.name="name" attr.type="string"/><key id="rr-edge-description" for="edge" attr.name="description" attr.type="string"/><key id="rr-edge-trafficweight" for="edge" attr.name="trafficWeight" attr.type="double"/><graph id="ravenroot-workflow" edgedefault="directed"><data key="rr-graph-join-semantics">declared</data><node id="start"><data key="rr-node-name">Start</data><data key="rr-node-kind">START</data><data key="rr-node-classification">start</data><data key="rr-node-layoutx">120</data><data key="rr-node-layouty">220</data><data key="rr-node-layoutwidth">80</data><data key="rr-node-layoutheight">52</data></node><node id="dosomething"><data key="rr-node-name">Do something</data><data key="rr-node-kind">PASSTHROUGH</data><data key="rr-node-classification">flow</data><data key="rr-node-layoutx">300</data><data key="rr-node-layouty">220</data><data key="rr-node-layoutwidth">80</data><data key="rr-node-layoutheight">52</data></node><node id="error"><data key="rr-node-name">Error</data><data key="rr-node-kind">ERROR</data><data key="rr-node-classification">error</data><data key="rr-node-layoutx">300</data><data key="rr-node-layouty">380</data><data key="rr-node-layoutwidth">80</data><data key="rr-node-layoutheight">52</data></node><node id="end"><data key="rr-node-name">End</data><data key="rr-node-kind">END</data><data key="rr-node-classification">end</data><data key="rr-node-layoutx">480</data><data key="rr-node-layouty">220</data><data key="rr-node-layoutwidth">80</data><data key="rr-node-layoutheight">52</data></node><node id="review"><data key="rr-node-name">Review</data><data key="rr-node-kind">PASSTHROUGH</data><data key="rr-node-classification">flow</data><data key="rr-node-layoutx">480</data><data key="rr-node-layouty">340</data><data key="rr-node-layoutwidth">80</data><data key="rr-node-layoutheight">52</data></node><node id="archive"><data key="rr-node-name">Archive</data><data key="rr-node-kind">PASSTHROUGH</data><data key="rr-node-classification">flow</data><data key="rr-node-layoutx">480</data><data key="rr-node-layouty">460</data><data key="rr-node-layoutwidth">80</data><data key="rr-node-layoutheight">52</data></node><edge id="edge-start-dosomething" source="start" target="dosomething"><data key="rr-edge-outcome">continue</data><data key="rr-edge-status">0</data><data key="rr-edge-parallel">false</data></edge><edge id="edge-dosomething-end" source="dosomething" target="review"><data key="rr-edge-outcome">continue</data><data key="rr-edge-status">0</data><data key="rr-edge-parallel">false</data></edge><edge id="edge-dosomething-error" source="dosomething" target="error"><data key="rr-edge-outcome">failed</data><data key="rr-edge-status">0</data><data key="rr-edge-parallel">false</data></edge><edge id="edge-1" source="review" target="end"><data key="rr-edge-slaminutes">30</data><data key="rr-edge-outcome">approved</data><data key="rr-edge-name">Approval branch</data><data key="rr-edge-status">200</data><data key="rr-edge-parallel">false</data><data key="rr-edge-description">Taken when the reviewer approves</data></edge><edge id="edge-2" source="review" target="archive"><data key="rr-edge-outcome">rejected</data><data key="rr-edge-name">Rejection branch</data><data key="rr-edge-status">0</data><data key="rr-edge-parallel">true</data><data key="rr-edge-trafficweight">0.25</data></edge><edge id="edge-3" source="archive" target="end"><data key="rr-edge-outcome">continue</data><data key="rr-edge-status">0</data><data key="rr-edge-parallel">false</data></edge></graph></graphml>