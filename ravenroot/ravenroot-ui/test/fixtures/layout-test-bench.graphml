<?xml version="1.0" encoding="UTF-8"?>
<!--
  Layout test bench for the design editor's automatic arrangements.

  One coordinator delegates to twelve peers that fan back into one join, behind a linear intake
  chain and ahead of a gate/review/merge tail; escalation, human-task, audit, error and recovery
  nodes are reachable from almost everywhere, and several edges run backwards (no-issue, rework,
  changes-requested, retry). 27 nodes, 82 edges. Edges into the ERROR node carry the
  default outcome and are therefore implicit failure routes.
-->
<graphml xmlns="http://graphml.graphdrawing.org/xmlns">
  <key id="name" for="node" attr.name="name" attr.type="string"/>
  <key id="kind" for="node" attr.name="kind" attr.type="string"/>
  <key id="classification" for="node" attr.name="classification" attr.type="string"/>
  <key id="x" for="node" attr.name="layoutX" attr.type="double"/>
  <key id="y" for="node" attr.name="layoutY" attr.type="double"/>
  <key id="w" for="node" attr.name="layoutWidth" attr.type="double"/>
  <key id="h" for="node" attr.name="layoutHeight" attr.type="double"/>
  <key id="outcome" for="edge" attr.name="outcome" attr.type="string"/>
  <graph id="layout-test-bench" edgedefault="directed">
    <node id="start">
      <data key="name">Start</data>
      <data key="kind">START</data>
      <data key="x">60</data>
      <data key="y">370</data>
      <data key="w">80</data>
      <data key="h">80</data>
    </node>
    <node id="poll">
      <data key="name">Poll every 10 seconds</data>
      <data key="kind">PASSTHROUGH</data>
      <data key="classification">system</data>
      <data key="x">130</data>
